# Footer "now" data (src/lib/now.js). Copy to .env.local for local dev and add the same names in
# Vercel → Project → Settings → Environment Variables. Any missing value just shows the placeholder text.

# Steam: key from https://steamcommunity.com/dev/apikey, and your 17-digit SteamID64.
# Your Steam profile's "Game details" privacy setting must be Public.
STEAM_API_KEY=
STEAM_ID=

# Spotify: app from https://developer.spotify.com/dashboard (Redirect URI http://127.0.0.1:8888/callback).
# Get the refresh token once with: node --env-file=.env.local scripts/spotify-token.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
